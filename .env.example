# PostgreSQL Database Connection URL
# Replace with your PostgreSQL connection string (Local or Cloud e.g. Neon, Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/myexpense?schema=public"

# Authentication Secret Key (Random secure string used for signing JWT cookies)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_at_least_32_characters"

# App Environment
NODE_ENV="development"
